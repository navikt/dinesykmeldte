    "@navikt/nav-dekoratoren-moduler": "^4.6.0",
    "@navikt/next-logger": "^5.0.2",
    "@navikt/oasis": "^4.2.2",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "csp-header": "^6.4.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "html-react-parser": "^6.1.9",
