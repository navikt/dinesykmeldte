    "jsdom": "^30.0.1",
    "next": "16.4.5",
    "next-logger": "5.0.2",
    "nextleton": "^0.6.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "remeda": "^2.58.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "zod": "4.6.7"
