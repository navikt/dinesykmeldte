{
  "name": "dinesykmeldte",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "start": "concurrently -n next,codegen \"pnpm run start:watch\" \"pnpm run gen:watch\"",
    "start:watch": "next dev | pino-pretty",
    "build": "next build",
    "test:watch": "vitest --config vitest.config.mts",
    "test": "vitest run --config vitest.config.mts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "gen": "graphql-codegen",
    "gen:watch": "graphql-codegen -w",
    "report-debt": "scripts/debt.sh",
    "prepare": "lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "@apollo/client": "3.12.11",
    "@apollo/server": "^5.5.0",
    "@as-integrations/next": "^4.1.0",
    "@grafana/faro-react": "2.10.0",
    "@graphql-tools/graphql-file-loader": "^8.0.14",
    "@graphql-tools/load": "^8.0.14",
    "@graphql-tools/merge": "^9.0.19",
    "@graphql-tools/schema": "^10.0.18",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nais/apm": "0.6.0",
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/dinesykmeldte-sidemeny": "^8.0.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/fnrvalidator": "^2.1.5",
    "@navikt/lumi-survey": "^0.4.0",
    "@navikt/nav-dekoratoren-moduler": "^4.3.0",
    "@navikt/next-logger": "^5.0.1",
    "@navikt/oasis": "^4.1.1",
    "@reduxjs/toolkit": "^2.11.0",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/dom": "^10.4.0",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "csp-header": "^6.3.1",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "html-react-parser": "^6.1.7",
    "jose": "^6.2.10",
    "jsdom": "^30.0.1",
    "next": "16.2.9",
    "next-logger": "5.0.2",
    "nextleton": "^0.6.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "remeda": "^2.44.0",
    "tailwind-merge": "^3.5.0",
    "ua-parser-js": "^2.0.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "5.0.4",
    "@graphql-codegen/fragment-matcher": "^5.1.0",
    "@graphql-codegen/typed-document-node": "^5.0.13",
    "@graphql-codegen/typescript-operations": "^4.4.1",
    "@graphql-codegen/typescript-resolvers": "^4.4.2",
    "@navikt/ds-tailwind": "^8.16.1",
    "@parcel/watcher": "^2.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.10",
    "next-router-mock": "^1.0.5",
    "open": "^11.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-dom": "^0.1.1"
  }
