    "@graphql-tools/schema": "^10.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nais/apm": "0.7.3",
    "@navikt/aksel-icons": "^8.21.0",
    "@navikt/dinesykmeldte-sidemeny": "^8.0.1",
